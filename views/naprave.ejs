<!DOCTYPE html>
<html lang="sl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Povezane naprave</title>
    <link rel="stylesheet" href="<%= proxy %>/public/main.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .devices-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr); /* 2 columns */
            grid-template-rows: repeat(2, minmax(250px, 1fr)); /* 2 rows */
            gap: 30px;
            padding: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .device-card {
            border: 1px solid #ccc;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            background-color: white;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            font-size: 1.2rem;
            transition: transform 0.2s;
        }
        .device-card:hover {
            transform: translateY(-5px);
        }
        .device-card h3 {
            margin-top: 0;
            color: #333;
            font-size: 2rem;
            margin-bottom: 20px;
        }
        .device-data {
            margin: 15px 0;
            font-size: 1.5em;
            line-height: 2;
        }
        .status-waiting {
            color: #666;
            font-style: italic;
        }
        .device-placeholder {
            border: 2px dashed #e0e0e0;
            background-color: #fafafa;
            color: #ccc;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 250px;
        }
        
        .chart-container {
            max-width: 1000px;
            margin: 40px auto;
            padding: 20px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <nav>
                <div class="logo">
                    <span class="logo-icon">🍎</span>
                    <span>WISFI - Kaj je v hrani</span>
                </div>
                <div class="nav-links">
                   <a href="<%= proxy %>/">Domov</a>
                    <a href="<%= proxy %>/seznam">Seznam</a>
                    <a href="<%= proxy %>/zemljevid">Zemljevid</a>
                    <a href="<%= proxy %>/public/kontakt.html">Kontakt</a>
                    <a href="<%= proxy %>/public/api.html">Api</a>
                    <a href="<%= proxy %>/nastavitve">Nastavitve</a>
                </div>
            </nav>
        </header>
    
    <div class="main-content">
        <h1>Povezane naprave</h1>
        
        <div id="devices-container" class="devices-grid">
            <div class="device-card status-waiting">
                <p>Čakanje na napravo...</p>
            </div>
            <!-- Placeholders to make it look like a grid for multiple devices -->
            <div class="device-card device-placeholder">Prosto mesto</div>
            <div class="device-card device-placeholder">Prosto mesto</div>
            <div class="device-card device-placeholder">Prosto mesto</div>
        </div>

        <div class="chart-container">
            <canvas id="readingsChart"></canvas>
        </div>
    </div>

    <script>
        const PROXY = "<%= proxy %>";
        let chart;
        const maxDataPoints = 50;
        
        // Initialize Chart
        function initChart() {
            const ctx = document.getElementById('readingsChart').getContext('2d');
            chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'Temperatura (°C)',
                        data: [],
                        borderColor: 'rgb(255, 99, 132)',
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        tension: 0.4,
                        yAxisID: 'y'
                    }, {
                        label: 'Napetost (V)',
                        data: [],
                        borderColor: 'rgb(54, 162, 235)',
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        tension: 0.4,
                        yAxisID: 'y1'
                    }]
                },
                options: {
                    responsive: true,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    stacked: false,
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: 'Temperatura (°C)'
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Napetost (V)'
                            },
                            grid: {
                                drawOnChartArea: false,
                            },
                        }
                    }
                }
            });
        }

        function updateChart(temp, voltage) {
            const now = new Date();
            const timeLabel = now.getHours() + ':' + now.getMinutes() + ':' + now.getSeconds();

            if (chart.data.labels.length > maxDataPoints) {
                chart.data.labels.shift();
                chart.data.datasets[0].data.shift();
                chart.data.datasets[1].data.shift();
            }

            chart.data.labels.push(timeLabel);
            chart.data.datasets[0].data.push(temp);
            chart.data.datasets[1].data.push(voltage);
            chart.update();
        }


        function updateDevices() {
            fetch(`${PROXY}/api/device-status`)
                .then(response => response.json())
                .then(data => {
                    const container = document.getElementById('devices-container');
                    
                    if (data && data.connected) {
                        try {
                            const temp = data.temp !== undefined ? data.temp : null;
                            const voltage = data.voltage !== undefined ? data.voltage : null;
                            
                            // Update Grid UI
                            container.innerHTML = `
                                <div class="device-card" style="border-color: #4CAF50; background-color: #f0fff4;">
                                    <h3>Naprava 1</h3>
                                    <div class="device-data">
                                        <div>Temp: <strong>${temp ?? '-'} °C</strong></div>
                                        <div>Napetost: <strong>${voltage ?? '-'} V</strong></div>
                                    </div>
                                    <div style="margin-top: auto; color: #666;">
                                        Zadnjič videno: ${new Date(data.lastSeen).toLocaleTimeString()}
                                    </div>
                                </div>
                                <div class="device-card device-placeholder">Prosto mesto</div>
                                <div class="device-card device-placeholder">Prosto mesto</div>
                                <div class="device-card device-placeholder">Prosto mesto</div>
                            `;

                            // Update Chart
                            if (temp !== null && voltage !== null) {
                                updateChart(temp, voltage);
                            }
                        } catch (e) {
                            console.error("Error updating UI", e);
                        }
                    } else {
                        // Waiting
                        container.innerHTML = `
                            <div class="device-card status-waiting">
                                <h3 style="color: #666;">Iskanje...</h3>
                                <div style="font-size: 3rem; margin: 20px;"></div>
                                <p>Čakanje na povezavo naprave...</p>
                            </div>
                            <div class="device-card device-placeholder">Prosto mesto</div>
                            <div class="device-card device-placeholder">Prosto mesto</div>
                            <div class="device-card device-placeholder">Prosto mesto</div>
                        `;
                    }
                })
                .catch(err => console.error('Error fetching device status:', err));
        }

        // Init
        initChart();
        setInterval(updateDevices, 2000);
        updateDevices();
    </script>
    </div> <!-- End container -->
</body>
</html>
